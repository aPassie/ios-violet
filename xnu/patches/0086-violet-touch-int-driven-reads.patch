+/* NVT register read: index write (held bus), 200 us, then read. A tight
+ * index-write -> read sequence is often not applied by this firmware
+ * (violet-shim m3g, research/touch-rootcause.md); Linux has IRQ/thread
+ * latency there. */
+static int
+nvt_read(uint8_t reg, uint8_t *buf, unsigned len)
+{
+	int err = touch_msg(NVT_FW, &reg, 1, NULL, 0, true);
+	if (err) {
+		return err;
+	}
+	delay(200);
+	return touch_msg(NVT_FW, NULL, 0, buf, len, false);
+}
