+/*
+ * Panel pixel -> presented-display pixel. The 1125x2436 image is centered on
+ * the panel (SweetFramebuffer.cpp), so `off` pixels are cut off on each side
+ * (violet: 22 x, 48 y). A plain offset means a finger on the physical edge
+ * never reaches the display edge, and iOS edge gestures (home swipe from the
+ * bottom, Control Center / notifications from the top) cannot start. Inside
+ * a `band` of panel pixels at each edge the mapping is stretched so the
+ * physical edge reaches the display edge; elsewhere it stays 1:1.
+ */
+static int
+sweet_edge_map(int v, int panel, int logical, int band)
+{
+	int off = (logical - panel) / 2;
+	if (off <= 0 || band <= 0 || 2 * band >= panel) {
+		return v + (off > 0 ? off : 0);
+	}
+	if (v < band) {
+		return v * (band + off) / band;
+	}
+	if (v >= panel - band) {
+		int far = logical - 1, start = panel - band + off;
+		return start + (v - (panel - band)) * (far - start) / (band - 1);
+	}
+	return v + off;
+}
