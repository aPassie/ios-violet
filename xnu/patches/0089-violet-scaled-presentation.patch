+	int64_t px1 = ((int64_t)(dx + w) * panelW + logW - 1) / logW;
+	int64_t py0 = ((int64_t)dy * panelH + logH - 1) / logH;
+	int64_t py1 = ((int64_t)(dy + h) * panelH + logH - 1) / logH;
+	if (px1 > (int64_t)panelW) {
