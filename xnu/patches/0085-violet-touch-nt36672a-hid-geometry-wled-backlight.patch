diff --git a/bsd/dev/sweet_spmi.c b/bsd/dev/sweet_spmi.c
index 1981490..1ba9ec6 100644
--- a/bsd/dev/sweet_spmi.c
+++ b/bsd/dev/sweet_spmi.c
@@ -10,6 +10,7 @@
 #include <sys/systm.h>
 #include <machine/machine_routines.h>
 #include <IOKit/IOLocks.h>
+#include <pexpert/device_tree.h>
 #include "sweet_spmi.h"
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
@@ -123,4 +124,154 @@ sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 	IOLockUnlock(sp_lock);
 	return -1;
 }
+
+/*
+ * VIOLET (SM6150): LCD backlight = PM6150L WLED5 on SPMI SID 5, ctrl
+ * peripheral 0xd8 (0xd800), sink 0xd9 (0xd900). Spec: research/violet-wled.md.
+ * These are the only PMIC WRITES in this file. They are restricted to those two
+ * peripherals, to APIDs owned by the apps EE (0), go through the v5 channel
+ * (chnls 0xc600000 + 0x10000 * APID: WDATA0 +0x10, CMD +0x00, STATUS +0x08),
+ * and run only when the ADT has /violet-wled. Sweet (AMOLED) is unaffected.
+ *   off: MOD_EN (0xd846 bit 7) = 0, nothing else (current limits, OVP, CABC kept)
+ *   on : modulator A brightness 0xd953/0xd954 (12-bit) + sync toggle 0xd965,
+ *        then MOD_EN = 1. Brightness is the value ABL left, cached at setup.
+ */
+#define WL_SID          5u
+#define SP_CHNLS_PA     0x0c600000u
+
+static bool wl_tried, wl_ok;
+static uint8_t wl_lsb, wl_msb;
+static uint16_t wl_apid[2];             /* 0 = ctrl 0xd8, 1 = sink 0xd9 */
+static vm_offset_t wl_chan[2];
+
+static int
+sp_obs_read_apid(uint16_t apid, unsigned reg, uint8_t *out)
+{
+	if (sp_poisoned[apid]) {
+		return -1;
+	}
+	unsigned off = 0x80u * apid;
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(sp_obs + off) = (1u << 27) | ((reg & 0xffu) << 4);
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(sp_obs, off + 0x08u);
+		if (status & 1u) {
+			if (status & 0x0eu) {
+				return -1;
+			}
+			*out = (uint8_t)sp_rd(sp_obs, off + 0x18u);
+			return 0;
+		}
+		delay(1);
+	}
+	sp_poisoned[apid] = true;
+	return -1;
+}
+
+static int
+sp_chan_write(unsigned idx, unsigned reg, uint8_t val)
+{
+	uint16_t apid = wl_apid[idx];
+	vm_offset_t ch = wl_chan[idx];
+	if (sp_poisoned[apid]) {
+		return -1;
+	}
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(ch + 0x10u) = val;                       /* WDATA0 */
+	*(volatile uint32_t *)(ch + 0x00u) = (0u << 27) | ((reg & 0xffu) << 4); /* EXT_WRITEL, BC=0 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(ch, 0x08u);
+		if (status & 1u) {
+			return (status & 0x0eu) ? -1 : 0;
+		}
+		delay(1);
+	}
+	sp_poisoned[apid] = true;
+	return -1;
+}
+
+static int
+wl_setup(void)
+{
+	DTEntry node;
+	if (wl_tried) {
+		return wl_ok ? 0 : -1;
+	}
+	wl_tried = true;
+	if (SecureDTLookupEntry(NULL, "/violet-wled", &node) != kSuccess || sweet_spmi_init()) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	for (unsigned i = 0; i < 2; ++i) {
+		unsigned ppid = (WL_SID << 8) | (0xd8u + i);
+		uint16_t apid = sp_find_apid(ppid);
+		unsigned owner = apid == SP_NO_APID ? 0xffu : (sp_rd(sp_cfg, 0x700u + 4u * apid) & 7u);
+		printf("VIOLET WLED: ppid %#x APID %u owner %u\n", ppid, apid, owner);
+		if (apid == SP_NO_APID || owner != 0) {
+			IOLockUnlock(sp_lock);
+			return -1;
+		}
+		wl_apid[i] = apid;
+		wl_chan[i] = ml_io_map(SP_CHNLS_PA + 0x10000u * apid, 0x4000);
+		if (!wl_chan[i]) {
+			IOLockUnlock(sp_lock);
+			return -1;
+		}
+	}
+	uint8_t en = 0;
+	int err = sp_obs_read_apid(wl_apid[0], 0x46, &en);
+	if (!err) {
+		err = sp_obs_read_apid(wl_apid[1], 0x53, &wl_lsb);
+	}
+	if (!err) {
+		err = sp_obs_read_apid(wl_apid[1], 0x54, &wl_msb);
+	}
+	IOLockUnlock(sp_lock);
+	unsigned level = ((unsigned)(wl_msb & 0x0fu) << 8) | wl_lsb;
+	printf("VIOLET WLED: read err=%d mod_en=%#x brightness=%u\n", err, en, level);
+	if (err) {
+		return -1;
+	}
+	if (level < 4) {                        /* nothing usable left by ABL */
+		wl_lsb = 0xff;
+		wl_msb = 0x07;                  /* 2047 of 4095 */
+	}
+	wl_ok = true;
+	return 0;
+}
+
+void violet_backlight(int on);
+
+/* Thread context (IOMobileFramebuffer power change). Never called on sweet. */
+void
+violet_backlight(int on)
+{
+	if (wl_setup()) {
+		return;
+	}
+	IOLockLock(sp_lock);
+	uint8_t en = 0;
+	int err = sp_obs_read_apid(wl_apid[0], 0x46, &en);
+	if (!err && on) {
+		err = sp_chan_write(1, 0x53, wl_lsb);
+		if (!err) {
+			err = sp_chan_write(1, 0x54, (uint8_t)(wl_msb & 0x0fu));
+		}
+		if (!err) {
+			err = sp_chan_write(1, 0x65, 1);        /* sync: latch brightness */
+		}
+		if (!err) {
+			err = sp_chan_write(1, 0x65, 0);
+		}
+		if (!err) {
+			err = sp_chan_write(0, 0x46, (uint8_t)(en | 0x80u));
+		}
+	} else if (!err) {
+		err = sp_chan_write(0, 0x46, (uint8_t)(en & ~0x80u));
+	}
+	IOLockUnlock(sp_lock);
+	printf("VIOLET WLED: backlight %s (err %d, mod_en was %#x)\n", on ? "on" : "off", err, en);
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
