+static int
+nvt_page_event(void)
+{
+	static const uint8_t pg[3] = {0xff, 0x02, 0x1c};      /* EVENT_BUF_ADDR 0x21C00 */
+	return touch_msg(NVT_FW, pg, sizeof(pg), NULL, 0, false);
+}
+
+static int
+nvt_state(uint8_t *state)
+{
+	uint8_t b[5];
+	int err = touch_read(NVT_FW, 0x60, false, b, sizeof(b));
+	if (!err) {
+		*state = b[0];
+	}
+	return err;
+}
+
+/* Reached normal run (0xA0..0xAF)? Else Linux's recovery: bootloader reset. */
+static bool
+nvt_probe(void)
+{
+	uint8_t state = 0;
+	int err = nvt_page_event();
+	if (!err) {
+		err = nvt_state(&state);
+	}
+	printf("SWEET TOUCH: NT36672A page err=%d state=%#x\n", err, state);
+	if (!err && state >= 0xa0 && state <= 0xaf) {
+		return true;
+	}
+	static const uint8_t nvt_reset_cmd[2] = {0x00, 0x69};
+	err = touch_msg(NVT_HW, nvt_reset_cmd, sizeof(nvt_reset_cmd), NULL, 0, false);
+	touch_wait(35);
+	for (unsigned i = 0; i < 100; ++i) {
+		state = 0;
+		if (!nvt_page_event() && !nvt_state(&state) && state >= 0xa1 && state <= 0xaf) {
+			break;
+		}
+		touch_wait(10);
+	}
+	printf("SWEET TOUCH: NT36672A bootloader reset err=%d state=%#x\n", err, state);
+	return state >= 0xa1 && state <= 0xaf;
+}
+
+static int
+touch_novatek(void)
+{
+	uint8_t buf[65];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	int err = touch_read(NVT_FW, 0x00, false, buf, sizeof(buf));
+	if (err) {
+		return err;
+	}
+	if (buf[1] == 0x77 && buf[2] == 0x77 && buf[3] == 0x77 &&
+	    buf[4] == 0x77 && buf[5] == 0x77 && buf[6] == 0x77) {
+		return EIO;     /* firmware ESD pattern */
+	}
+	for (unsigned i = 0; i < TOUCH_MAX; ++i) {
+		const uint8_t *e = buf + 6u * i;
+		unsigned id = e[0] >> 3, status = e[0] & 7u;
+		if (id == 0 || id > TOUCH_MAX || (status != 1u && status != 2u)) {
+			continue;       /* empty slot or released */
+		}
+		unsigned px = ((unsigned)e[1] << 4) | (e[3] >> 4);
+		unsigned py = ((unsigned)e[2] << 4) | (e[3] & 15u);
+		if (px > 1079 || py > 2339 || (mask & (1u << (id - 1)))) {
+			continue;
+		}
+		mask |= 1u << (id - 1);
+		x[id - 1] = (int)px;
+		y[id - 1] = (int)py;
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
