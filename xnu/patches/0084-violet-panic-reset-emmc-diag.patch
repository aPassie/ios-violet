+++ b/osfmk/kern/debug.c
@@ -1176,6 +1176,11 @@ kdp_machine_reboot_type(unsigned int type, uint64_t debugger_flags)
 	} else {
 		PEHaltRestart(type);
 	}
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/* violet/sweet: no platform reset driver; warm-reset through PSCI (bsd/dev/sweet_ufs.c) */
+	extern void violet_platform_reset(unsigned int type);
+	violet_platform_reset(type);
+#endif
 	halt_all_cpus(TRUE);
 }
 
