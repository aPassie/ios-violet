+/*
+ * VIOLET: platform reset, called from kdp_machine_reboot_type()
+ * (osfmk/kern/debug.c) after PEHaltRestart. There is no reset driver, so a
+ * panic used to leave the phone frozen until a long power-key press, which is
+ * a cold reset that also decays the pstore RAM holding the logs. After a
+ * panic: wait panicreset= seconds (default 20, 0 = stay on the panic screen),
+ * then PSCI SYSTEM_RESET (warm: RAM keeps the logs, the phone boots Android).
+ */
+void violet_platform_reset(unsigned int type);
+
+void
+violet_platform_reset(unsigned int type)
+{
+	uint32_t secs = 20;
+	PE_parse_boot_argn("panicreset", &secs, sizeof(secs));
+	if (type == kPEPanicRestartCPU || type == kPEPanicRestartCPUNoCallouts) {
+		if (secs == 0) {
+			return;
+		}
+		delay((int)MIN(secs, 600u) * 1000000);
+	}
+	register uint64_t x0 __asm__("x0") = 0x84000009;   /* PSCI SYSTEM_RESET */
+	__asm__ volatile ("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "memory");
+}
+
 /* Root device for rd=ufsroot0 (IOFindBSDRoot). */
 int sweet_ufs_rootdev(dev_t *dev);
 
diff --git a/osfmk/kern/debug.c b/osfmk/kern/debug.c
